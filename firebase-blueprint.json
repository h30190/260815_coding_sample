{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["architect", "admin", "staff"] },
        "office": { "type": "string", "maxLength": 100 }
      },
      "required": ["uid", "email", "role"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "A single clock-in or clock-out event",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["clock_in", "clock_out"] },
        "isField": { "type": "boolean" },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "accuracy": { "type": "number" },
            "siteName": { "type": "string", "maxLength": 200 }
          }
        },
        "note": { "type": "string", "maxLength": 500 }
      },
      "required": ["userId", "timestamp", "type", "isField"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of all attendance events"
    }
  }
}
